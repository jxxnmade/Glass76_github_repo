# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,cpp,h,hpp}]
indent_size = 4

[*.{cmake,txt}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.{yml,yaml,json,uidesc}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# NSIS and PowerShell are Windows-only and MSVC-adjacent; CRLF keeps diffs
# clean when they are edited in Windows tooling.
[*.{nsi,nsh,ps1,rc}]
end_of_line = crlf
