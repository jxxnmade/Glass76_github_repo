# Normalise line endings on the way in; check out native.
* text=auto

# Windows-only tooling. NSIS and PowerShell are happier with CRLF, and forcing
# it keeps diffs clean when they are edited with Windows editors.
*.nsi  text eol=crlf
*.nsh  text eol=crlf
*.ps1  text eol=crlf
*.rc   text eol=crlf
*.bat  text eol=crlf

# Never touched by normalisation.
*.ttf     binary
*.otf     binary
*.ico     binary
*.png     binary
*.vst3    binary

# GitHub's language stats should describe the plug-in, not its resources.
resource/Fonts/**  linguist-vendored
*.uidesc           linguist-language=XML
